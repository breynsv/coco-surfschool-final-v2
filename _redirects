# ---- Private/internal files (source, docs, tooling) — not site content ----
# pages_build_output_dir="." means every committed path is publicly served by
# default. These are not merely unindexed (see robots.txt) — they are hard
# 404s so they are unreachable outright. Keep this list in sync with anything
# new committed at the repo root that isn't meant to be public.
/REPORT-OWNER.md      /404.html   404
/README.md            /404.html   404
/DESIGN.md            /404.html   404
/build.mjs            /404.html   404
/wrangler.toml        /404.html   404
/.htaccess            /404.html   404
/.gitignore           /404.html   404
/.dev.vars.example    /404.html   404
/docs/*               /404.html   404
/content/*            /404.html   404
/test/*               /404.html   404
/scripts/*            /404.html   404
/.impeccable/*        /404.html   404
/.github/*            /404.html   404
